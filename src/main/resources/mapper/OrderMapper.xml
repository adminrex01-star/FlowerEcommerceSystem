<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.flower.mapper.OrderMapper">
    <resultMap id="OrderResultMap" type="com.flower.po.Order">
        <id column="order_id" property="orderId"/>
        <result column="user_id" property="userId"/>
        <result column="total_price" property="totalPrice"/>
        <result column="order_status" property="orderStatus"/>
        <result column="pay_status" property="payStatus"/>
        <result column="receiver" property="receiver"/>
        <result column="phone" property="phone"/>
        <result column="address" property="address"/>
        <result column="create_time" property="createTime"/>
        <result column="username" property="username"/>
    </resultMap>

    <select id="selectByUserId" resultMap="OrderResultMap">
        SELECT o.*, u.username
        FROM `order` o
        JOIN user u ON o.user_id = u.user_id
        WHERE o.user_id = #{userId}
        ORDER BY o.order_id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countByUserId" resultType="long">
        SELECT COUNT(*) FROM `order` WHERE user_id = #{userId}
    </select>

    <select id="selectAll" resultMap="OrderResultMap">
        SELECT o.*, u.username
        FROM `order` o
        JOIN user u ON o.user_id = u.user_id
        ORDER BY o.order_id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM `order`
    </select>

    <select id="selectById" resultMap="OrderResultMap">
        SELECT o.*, u.username
        FROM `order` o
        JOIN user u ON o.user_id = u.user_id
        WHERE o.order_id = #{orderId}
    </select>

    <insert id="insertOrder" useGeneratedKeys="true" keyProperty="orderId">
        INSERT INTO `order` (user_id, total_price, receiver, phone, address)
        VALUES (#{userId}, #{totalPrice}, #{receiver}, #{phone}, #{address})
    </insert>

    <insert id="insertOrderItem">
        INSERT INTO order_item (order_id, product_id, product_name, price, num)
        VALUES (#{orderId}, #{productId}, #{productName}, #{price}, #{num})
    </insert>

    <update id="updateOrderStatus">
        UPDATE `order` SET order_status = #{orderStatus} WHERE order_id = #{orderId}
    </update>

    <delete id="deleteOrder">
        DELETE FROM `order` WHERE order_id = #{orderId}
    </delete>

    <select id="selectItemsByOrderId" resultType="com.flower.po.OrderItem">
        SELECT * FROM order_item WHERE order_id = #{orderId}
    </select>
</mapper>